<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>vertical</Layout>
    <Size>100me,60f</Size>
    <Children>
      <WidgetGroup>
          <ObjectName>FonsBarra</ObjectName>
          <Layout>horizontal</Layout>
              <Size>100me,60f</Size>
          <Children>
              <WidgetGroup> <!--ICONA BROWSE-->
              <ObjectName>TabControls</ObjectName>
              <Layout>vertical</Layout>
              <Size>55f,60f</Size>
              <Children>
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">⬅</SetVariable>
                  <SetVariable name="config_key">library</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>
              
              <PushButton>
                <ObjectName>DeckFocus</ObjectName>
                <Size>48f,60f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1</Text></State>
                <State><Number>1</Number><Text>2</Text></State>
                <Connection><ConfigKey>[Skin],active_deck</ConfigKey></Connection>
              </PushButton>
              <WidgetStack currentpage="[Skin],active_deck">
                <ObjectName>TopbarCoverStack</ObjectName>
                <Size>60f,60f</Size>
                <Children>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <Children>
                      <CoverArt>
                        <ObjectName>DeckCoverArt</ObjectName>
                        <TooltipId>coverart</TooltipId>
                        <Size>60f,60f</Size>
                        <Channel>1</Channel>
                      </CoverArt>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup trigger="[Skin],active_deck">
                    <Layout>horizontal</Layout>
                    <Children>
                      <CoverArt>
                        <ObjectName>DeckCoverArt</ObjectName>
                        <TooltipId>coverart</TooltipId>
                        <Size>60f,60f</Size>
                        <Channel>2</Channel>
                      </CoverArt>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetStack>
              <WidgetStack currentpage="[Skin],active_deck">
                <ObjectName>TopbarTrackStack</ObjectName>
                <Size>3s,60f</Size>
                <Children>
                  <Template src="skin:topbar_trackinfo.xml">
                    <SetVariable name="channel">1</SetVariable>
                  </Template>
                  <WidgetGroup trigger="[Skin],active_deck">
                    <Layout>horizontal</Layout>
                    <Children>
                      <Template src="skin:topbar_trackinfo.xml">
                        <SetVariable name="channel">2</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetStack>


            <!--Botons part dreta-->
            <WidgetGroup>
              <ObjectName>RightButtons</ObjectName>
                  <Layout>horizontal</Layout>

                  <Size>1s,60f</Size>
                  <Children>
                    <WidgetGroup> 
                  <ObjectName>TabControls</ObjectName>
                <Layout>vertical</Layout>
                  <Size>85f,60f</Size>
               <Children>
                  
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">HOT&#xA;CUE</SetVariable>
                  <SetVariable name="config_key">hotcues</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>
              
              <WidgetGroup><Size>15f,60f</Size></WidgetGroup>

                <WidgetGroup> 
                  <ObjectName>TabControls</ObjectName>
                <Layout>vertical</Layout>
                  <Size>85f,60f</Size>
               <Children>
                  
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">BEAT&#xA;LOOP</SetVariable>
                  <SetVariable name="config_key">beatloop</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>
              <WidgetGroup><Size>15f,60f</Size></WidgetGroup>


              <WidgetGroup> 
                  <ObjectName>TabControls</ObjectName>
                <Layout>vertical</Layout>
                  <Size>85f,60f</Size>
               <Children>
                  
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">KEY&#xA;SHIFT</SetVariable>
                  <SetVariable name="config_key">keyshift</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>
              <WidgetGroup><Size>15f,60f</Size></WidgetGroup>

              <WidgetGroup> 
                  <ObjectName>TabControls</ObjectName>
                <Layout>vertical</Layout>
                  <Size>85f,60f</Size>
               <Children>
                  
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">BEAT&#xA;JUMP</SetVariable>
                  <SetVariable name="config_key">beatjump</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>

               <WidgetGroup><Size>15f,60f</Size></WidgetGroup>


              <WidgetGroup> 
                  <ObjectName>TabControls</ObjectName>
                <Layout>vertical</Layout>
                  <Size>85f,60f</Size>
               <Children>
                  
                  <Template src="skin:tab.xml">
                  <SetVariable name="tab_name">STEMS</SetVariable>
                  <SetVariable name="config_key">stems</SetVariable>
                  </Template>
              </Children>
              </WidgetGroup>
              <WidgetGroup><Size>8f,60f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>ZedWifiButton</ObjectName>
                <Size>68f,60f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>WI-FI</Text></State>
                <State><Number>1</Number><Text>WI-FI</Text></State>
                <Connection>
                  <ConfigKey>[Skin],wifi_settings</ConfigKey>
                  <ConnectValueToWidget>false</ConnectValueToWidget>
                </Connection>
                <Connection>
                  <ConfigKey>[Skin],wifi_connected</ConfigKey>
                  <ConnectValueFromWidget>false</ConnectValueFromWidget>
                  <ConnectValueToWidget>true</ConnectValueToWidget>
                </Connection>
              </PushButton>

                    
                
                  </Children>
                </WidgetGroup>

           </Children>
        </WidgetGroup>

    
      
          



    </Children>
 </WidgetGroup>

   
</Template>

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2478,5 +2478,15 @@
     # GIT_TAG "origin/name-of-your-branch"
     #
+    # GCC 14 diagnoses a false-positive stringop-overflow in the bundled
+    # Howard Hinnant date header used by libdjinterop 0.24.3. That dependency
+    # unconditionally enables -Werror, so a clean Raspberry Pi OS build stops
+    # before any Mixxx source is compiled. Keep the exception scoped to the
+    # fetched dependency and to the affected compiler generation.
+    set(DJINTEROP_CXX_FLAGS "")
+    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND
+        CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 14)
+      set(DJINTEROP_CXX_FLAGS "-Wno-error=stringop-overflow")
+    endif()
     ExternalProject_Add(libdjinterop
       URL
         "https://github.com/xsco/libdjinterop/archive/refs/tags/${LIBDJINTEROP_VERSION}.tar.gz"
@@ -2504,6 +2514,7 @@
         -$<IF:$<BOOL:${CMAKE_OSX_ARCHITECTURES}>,D,U>CMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}
         -DCMAKE_SYSTEM_PROCESSOR=${CMAKE_SYSTEM_PROCESSOR}
         -DCMAKE_SYSTEM_NAME=${CMAKE_SYSTEM_NAME}
+        -DCMAKE_CXX_FLAGS:STRING=${DJINTEROP_CXX_FLAGS}
         -DSYSTEM_SQLITE=${DJINTEROP_SYSTEM_SQLITE}
       BUILD_COMMAND ${CMAKE_COMMAND} --build . --target DjInterop
       BUILD_BYPRODUCTS <INSTALL_DIR>/${DJINTEROP_LIBRARY}

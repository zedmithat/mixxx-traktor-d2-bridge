+bool CueControl::seekToFirstBeatAutoCue(const TrackPointer& pTrack) {
+    if (!pTrack) {
+        return false;
+    }
+
+    /* A deliberately stored Main Cue always wins. Hot cues are intentionally
+     * never inspected or modified by this load policy. */
+    const auto mainCuePosition = pTrack->getMainCuePosition();
+    if (mainCuePosition.isValid() &&
+            mainCuePosition != mixxx::audio::kStartFramePos) {
+        seekOnLoad(mainCuePosition);
+        return true;
+    }
+
+    const auto pBeats = pTrack->getBeats();
+    if (!pBeats) {
+        return false;
+    }
+    const auto firstBeatPosition = pBeats->firstBeat();
+    if (!firstBeatPosition.isValid()) {
+        return false;
+    }
+
+    /* Persist this as the independent Main Cue so the hardware CUE button
+     * returns to the same first kick. Track::setMainCuePosition emits
+     * cuesUpdated, which refreshes the cue_point ControlObject. */
+    pTrack->setMainCuePosition(firstBeatPosition);
+    seekOnLoad(firstBeatPosition);
+    return true;
+}

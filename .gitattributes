* text=auto
.gitattributes text eol=lf

# Files deployed directly to Linux must never acquire Windows CRLF endings.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.js text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.target text eol=lf
*.desktop text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.patch text eol=lf
*.xml text eol=lf
*.qml text eol=lf
*.qss text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary

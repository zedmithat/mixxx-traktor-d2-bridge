[Unit]
Description=ZED local library manager
After=zed-usb-monitor.service
Wants=zed-usb-monitor.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/bin/zed-manager.py --bind 0.0.0.0 --port 8088
Restart=on-failure
RestartSec=2
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/Music /home/pi/.config/zed-manager /run/user/1000

[Install]
WantedBy=default.target
